# =====================================================================
# Configuracion del backend (local y nube)
# Copia este archivo como .env para desarrollo local.
# En Render estas variables se inyectan desde el panel (Environment) o desde
# render.yaml; NO subas el .env real al repositorio.
# =====================================================================

# --- Base de datos PostgreSQL (local o Aiven) ---
# En Aiven, copia estos valores de "Connection information".
# OJO: el puerto de Aiven puede NO ser 5432; usa el que muestre el panel.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TU_CONTRASENA_AQUI
DB_NAME=autopulse_elite
# Local: dejar vacio. Aiven: obligatorio "require".
DB_SSLMODE=

# --- Aplicacion ---
APP_ENV=development
DEBUG=true

# --- CORS ---
# "*" = cualquier origen (comodo para pruebas).
# En produccion pon la URL del frontend en Vercel; admite varias separadas
# por coma, por ejemplo:
# CORS_ORIGINS=https://mi-frontend.vercel.app
CORS_ORIGINS=*

# --- Seguridad / JWT ---
# En Render se genera sola (render.yaml usa generateValue); en local usa una
# cadena larga y aleatoria.
JWT_SECRET_KEY=tu_clave_secreta_larga
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Puerto ---
# No se lee desde Python: Render define $PORT y el startCommand lo usa.
# Localmente uvicorn escucha en 8000 por defecto.
