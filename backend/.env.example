# =====================================================================
# Configuracion del backend (local y nube)
# Copia este archivo como .env para desarrollo local.
# En Railway estas variables se inyectan desde la pestana "Variables" del
# servicio; NO subas el .env real al repositorio.
# =====================================================================

# --- Base de datos PostgreSQL (local, Railway o Aiven) ---
# Railway: en el servicio PostgreSQL puedes referenciar sus variables con
#   DB_HOST=${{Postgres.PGHOST}}
#   DB_PORT=${{Postgres.PGPORT}}
#   DB_USER=${{Postgres.PGUSER}}
#   DB_PASSWORD=${{Postgres.PGPASSWORD}}
#   DB_NAME=${{Postgres.PGDATABASE}}
# Aiven: copia los valores de "Connection information" (el puerto puede no
# ser 5432).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TU_CONTRASENA_AQUI
DB_NAME=autopulse_elite
# Red interna de Railway: dejar vacio. Aiven o conexion publica: "require".
DB_SSLMODE=

# --- Aplicacion ---
APP_ENV=development
DEBUG=true

# --- CORS ---
# "*" = cualquier origen (comodo para pruebas).
# En produccion pon la URL del frontend en Railway; admite varias separadas
# por coma, por ejemplo:
# CORS_ORIGINS=https://mi-frontend.up.railway.app
CORS_ORIGINS=*

# --- Seguridad / JWT ---
# En la nube usa una cadena larga y aleatoria (por ejemplo `openssl rand -hex 32`).
JWT_SECRET_KEY=tu_clave_secreta_larga
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Puerto ---
# No se lee desde Python: Railway define $PORT y el startCommand lo usa.
# Localmente uvicorn escucha en 8000 por defecto.
