# =====================================================================
# Variables del frontend (Vite)
# Copia este archivo como .env para desarrollo local.
# En Railway se configuran en la pestana "Variables" del servicio.
# =====================================================================

# Origen del backend, SIN /api/v1 (el codigo agrega ese prefijo).
# Desarrollo local:
VITE_API_URL=http://localhost:8000

# Railway: usa el dominio publico del servicio backend, por ejemplo:
# VITE_API_URL=https://tu-backend.up.railway.app
#
# IMPORTANTE: Vite inyecta esta variable en TIEMPO DE COMPILACION.
# Si la cambias, debes volver a desplegar (rebuild) el frontend.
