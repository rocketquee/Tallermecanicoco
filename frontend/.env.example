# =====================================================================
# Variables del frontend (Vite)
# Copia este archivo como .env para desarrollo local.
# En Vercel se configuran en Project Settings -> Environment Variables.
# =====================================================================

# Origen del backend, SIN /api/v1 (el codigo agrega ese prefijo).
# Desarrollo local:
VITE_API_URL=http://localhost:8000

# Render (produccion):
# VITE_API_URL=https://tu-backend.onrender.com
#
# IMPORTANTE: Vite inyecta esta variable en TIEMPO DE COMPILACION.
# Si la cambias en Vercel, debes volver a desplegar (Redeploy) el frontend.
